<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login">

    <!-- CABEÇALHO -->

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_voltar"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_voltar"/>

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="180dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_progressa"/>

    </LinearLayout>

    <!-- TÍTULO -->

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Sessão de Estudos"
        android:textColor="#E9D9FF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CARD PRINCIPAL -->

    <LinearLayout
        android:id="@+id/cardEstudo"
        android:layout_width="0dp"
        android:layout_height="500dp"
        android:layout_margin="20dp"
        android:background="@drawable/bg_card_leitura"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CRONÔMETRO -->

        <TextView
            android:id="@+id/txtCronometro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="00:00:00"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"/>

        <!-- BOTÃO INICIAR -->

        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_botao_primario"
            android:text="▶ Iniciar"
            android:textColor="#FFFFFF"/>

        <!-- BOTÃO PAUSAR -->

        <Button
            android:id="@+id/btnPausar"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_botao_primario"
            android:text="⏸ Pausar"
            android:textColor="#FFFFFF"/>

        <!-- BOTÃO FINALIZAR -->

        <Button
            android:id="@+id/btnFinalizar"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_botao_primario"
            android:text="⏹ Finalizar"
            android:textColor="#FFFFFF"/>

        <!-- ESTATÍSTICAS -->

        <TextView
            android:id="@+id/txtHoje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Hoje: 0 min"
            android:textColor="#FFFFFF"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/txtSequencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🔥 0 dias estudados esta semana"
            android:textColor="#FFFFFF"
            android:textSize="18sp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>