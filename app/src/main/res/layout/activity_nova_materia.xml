<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#80000000"
            android:padding="24dp">

            <ImageView
                android:layout_width="160dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@drawable/logo_progressa"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nova Matéria"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"/>

            <EditText
                android:id="@+id/editNomeMateria"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nome da matéria"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:background="@drawable/bg_input_rounded"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editProfessor"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Professor"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:background="@drawable/bg_input_rounded"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editNota1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nota 1"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:background="@drawable/bg_input_rounded"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editNota2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nota 2"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:background="@drawable/bg_input_rounded"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editTrabalhos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nota dos trabalhos"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:background="@drawable/bg_input_rounded"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editCronograma"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top"
                android:hint="Cronograma"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:background="@drawable/bg_input_rounded"
                android:padding="12dp"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnSalvarMateria"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Salvar Matéria"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_botao_primario"
                app:backgroundTint="@null"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>